# Sao chép tệp này thành .env rồi điền giá trị. KHÔNG commit .env.
# .env đã nằm trong .gitignore; chỉ server đọc các biến này.

# Khoá API Google Gemini. Để trống → trợ lý chạy chế độ dự phòng
# bằng quy tắc (server/fallback.js) và mọi chức năng khác vẫn hoạt động.
GEMINI_API_KEY=

# Tên mô hình Gemini (tuỳ chọn). Mặc định: gemini-3.6-flash
# (các dòng 1.5-flash, 2.0-flash và 2.5-flash trả 404 với khoá mới).
GEMINI_MODEL=gemini-3.6-flash

# Thời gian chờ tối đa mỗi lần gọi Gemini, mili-giây (tuỳ chọn). Mặc định 30000
GEMINI_TIMEOUT_MS=30000

# Cổng máy chủ (tuỳ chọn). Mặc định 3000; Render tự đặt qua process.env.PORT.
PORT=3000

# Đặt "fallback" để ép chạy chế độ dự phòng dù có khoá (dùng khi thuyết trình
# trong mạng yếu). Để trống để dùng Gemini khi có khoá.
# CHAT_MODE=fallback
