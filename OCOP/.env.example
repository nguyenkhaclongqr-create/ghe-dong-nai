# Sao chép tệp này thành .env rồi điền giá trị. KHÔNG commit .env.
# .env đã nằm trong .gitignore; chỉ server đọc các biến này.

# Khoá API Groq (bắt đầu bằng "gsk_"). Để trống → trợ lý chạy chế độ dự phòng
# bằng quy tắc (server/fallback.js) và mọi chức năng khác vẫn hoạt động.
GROQ_API_KEY=

# Tên mô hình Groq (tuỳ chọn). Mặc định: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# Thời gian chờ tối đa mỗi lần gọi Groq, mili-giây (tuỳ chọn). Mặc định 15000
GROQ_TIMEOUT_MS=15000

# Cổng máy chủ (tuỳ chọn). Mặc định 3000; Render tự đặt qua process.env.PORT.
PORT=3000

# Đặt "fallback" để ép chạy chế độ dự phòng dù có khoá (dùng khi thuyết trình
# trong mạng yếu). Để trống để dùng Groq khi có khoá.
# CHAT_MODE=fallback
